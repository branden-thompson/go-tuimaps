+// letters writes a severity letter on an alert's outline every few cells
+// (OW-2 specimen, option C): E extreme, S severe, M moderate, m minor,
+// U unknown. A cell something else claimed keeps it.
+func (r *Renderer) letters() {
+	g := r.grid
+	for row := range g.rows {
+		for col := range g.cols {
+			c := &g.cells[row*g.cols+col]
+			if c.taken || c.glyph == blank || (col+2*row)%letterStride != 0 {
+				continue
+			}
+			var l string
+			switch colour.Token(c.ink) {
+			case colour.AlertExtremeOutline:
+				l = "E"
+			case colour.AlertSevereOutline:
+				l = "S"
+			case colour.AlertModerateOutline:
+				l = "M"
+			case colour.AlertMinorOutline:
+				l = "m"
+			case colour.AlertUnknownOutline:
+				l = "U"
+			default:
+				continue
+			}
+			g.write(col, row, textsafe.Clean(l), c.ink)
+		}
+	}
+}
+
+const letterStride = 5
+
+// shades lays an image's shade in every cell nothing else claimed (OW-2 specimen).
+func (r *Renderer) shades() {
+	g := r.grid
+	for i := range g.cells {
+		c := &g.cells[i]
+		if c.shade == "" || c.taken || c.glyph != blank {
+			continue
+		}
+		c.text, c.ink, c.taken = c.shade, uint8(colour.LabelRegion), true
+	}
+}
