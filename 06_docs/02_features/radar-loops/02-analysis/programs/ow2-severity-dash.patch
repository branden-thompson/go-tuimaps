diff -ru render.orig/hatch.go lib/internal/render/hatch.go
--- render.orig/hatch.go	2026-09-23 17:00:21
+++ lib/internal/render/hatch.go	2026-09-23 17:00:21
@@ -90,3 +90,59 @@
 func along(a, b Point, at, steps int) Point {
 	return Point{X: a.X + (b.X-a.X)*at/steps, Y: a.Y + (b.Y-a.Y)*at/steps}
 }
+
+// severityDash is an alert outline's dash, one a severity (OW-2 specimen,
+// D-17): on and off runs in dots, and the thickness. Extreme is solid and
+// thick; the line overlay's own dash is five on, four off, two thick.
+func severityDash(role uint8) ([]int, int, bool) {
+	switch colour.Token(role) {
+	case colour.AlertExtremeOutline:
+		return nil, 2, true
+	case colour.AlertSevereOutline:
+		return []int{8, 2}, 1, true
+	case colour.AlertModerateOutline:
+		return []int{4, 3}, 1, true
+	case colour.AlertMinorOutline:
+		return []int{1, 2}, 1, true
+	case colour.AlertUnknownOutline:
+		return []int{6, 2, 1, 2}, 1, true
+	}
+	return nil, 0, false
+}
+
+// pattern draws a ring with a dash sequence, carried across bends; an empty
+// sequence is a solid line.
+func (p *Painter) pattern(ring []Point, ink uint8, seq []int, thick int) {
+	if len(seq) == 0 {
+		for i := 0; i+1 < len(ring); i++ {
+			p.lines.Line(ring[i].X, ring[i].Y, ring[i+1].X, ring[i+1].Y, thick, ink)
+		}
+		return
+	}
+	period := 0
+	for _, n := range seq {
+		period += n
+	}
+	run := 0
+	for i := 0; i+1 < len(ring); i++ {
+		a, b := ring[i], ring[i+1]
+		steps := max(abs(b.X-a.X), abs(b.Y-a.Y))
+		for k := 0; k <= steps; k++ {
+			phase, on := run%period, false
+			for j, n := range seq {
+				if phase < n {
+					on = j%2 == 0
+					break
+				}
+				phase -= n
+			}
+			if on {
+				pt := along(a, b, k, max(steps, 1))
+				p.lines.Line(pt.X, pt.Y, pt.X, pt.Y, thick, ink)
+			}
+			if k < steps {
+				run++
+			}
+		}
+	}
+}
