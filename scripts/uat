#!/usr/bin/env bash
# Builds the app for a sitting, and says how to start one.
#
#   scripts/uat            build ./dist/tuimaps and print what to run
#   scripts/uat --frames   write the reference frames again (they are then
#                          HUM LEAD's to approve — plan task 14.16)
#
# The app's module requires the library at v0.0.0, a version that is never
# published, so it resolves the library from this tree. This script writes a
# throw-away workspace file **outside the repository** and builds through it:
# the tree is left exactly as it was found, because a tracked workspace file
# is something the gate refuses. Modules the build needs are fetched through
# the ordinary module proxy, so a fresh clone builds.

set -u
set -o pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root" || { echo "uat: cannot enter $root" >&2; exit 2; }

frames=0
for arg in "$@"; do
  case "$arg" in
    --frames) frames=1 ;;
    *) echo "uat: unknown argument: $arg" >&2; exit 2 ;;
  esac
done

if [ "$frames" = 1 ]; then
  echo "uat: writing the reference frames"
  TUIMAPS_WRITE_REFERENCE_FRAMES=1 GOFLAGS=-mod=readonly \
    go test -run TestReferenceFrames . || exit 1
  echo "uat: written to 06_docs/02_features/go-tuimaps/07-readiness/reference-frames"
  echo "uat: they are candidates until they are approved (plan task 14.16)"
  exit 0
fi

# The workspace's go line is the library's own go directive, which every
# module of the repository shares.
floor="$(sed -n 's/^go[[:space:]]\{1,\}\([0-9][0-9.]*\)[[:space:]]*$/\1/p' "$root/go.mod" | head -1)"
if [ -z "$floor" ]; then
  echo "uat: cannot read the go directive from $root/go.mod" >&2
  exit 2
fi
held="$(mktemp -d)"
work="$held/go.work"
trap 'rm -rf "$held"' EXIT
{
  echo "go $floor"
  echo
  echo "use ("
  echo "	$root"
  echo "	$root/cmd/tuimaps"
  echo ")"
  echo
  echo "replace github.com/branden-thompson/go-tuimaps v0.0.0 => $root"
} > "$work"

mkdir -p "$root/dist"
if ! GOWORK="$work" GOFLAGS=-mod=readonly CGO_ENABLED=0 \
  go build -o "$root/dist/tuimaps" ./cmd/tuimaps; then
  echo "uat: the app did not build" >&2
  exit 1
fi

echo "uat: built ./dist/tuimaps"
echo
echo "The sitting is written up in:"
echo "  06_docs/02_features/go-tuimaps/07-readiness/uat-instructions.md"
echo
echo "The shortest way in:"
echo "  ./dist/tuimaps --help"
echo "  ./dist/tuimaps --offline --scenario 1 --size 69x12 --headless --no-colour"
echo "  ./dist/tuimaps --offline --scenario 1"
echo
echo "A terminal whose font has no braille shows boxes where the map should be."
