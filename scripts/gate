#!/usr/bin/env bash
# The local gate. No remote exists until SHIP, so this script is what stands
# before every merge; at SHIP it becomes the hosted workflow.
#
#   scripts/gate            every leg
#   scripts/gate --quick    skip the slow legs: fuzzing, the vulnerability
#                           scan, licences, the cross-compile, the second
#                           architecture
#   scripts/gate --docs     the docs lane (v0.2.0 D-15, D-41): for a STAGED
#                           change that is Markdown and nothing else, every
#                           module's tests - which is where documents are read
#                           - and no other leg. Any other staged file is
#                           refused and sent to the full gate. Stage, run it,
#                           commit: with nothing staged it fails
#   scripts/gate --fuzz     the fuzz legs alone
#
# One mode at most a run. EVERY RUN IS LOGGED to 06_docs/gate-runs.md when
# that file exists - HEAD, the git tree that was tested, the mode, the result,
# the seconds it took and any override of the gate's settings (v0.2.0 D-31,
# D-40) - so "the gate was green" is a line anyone can check and M6's count of
# consecutive clean runs has something to count.
#
# GATE_ROOT names the tree to check; by default, the repository this script
# is in. Every module in the tree is checked, one by one - not only the
# library. The separate modules resolve the library through a throw-away
# workspace file written here and removed on exit; tracked module files
# carry no replace directive, and the workspace file is never tracked.
#
# What cannot run on this machine is listed at the end as NOT RUN, never
# counted as passed: Linux, Windows, real amd64 hardware, a nightly soak.

set -u
set -o pipefail

FLOOR_TOOLCHAIN="go1.25.0"

# THE FUZZ BUDGET IS A COUNT OF RUNS, NOT A STRETCH OF TIME (D-9). With
# `-fuzztime <duration>` the engine's coordinator can report its own deadline
# as a failure: a parent context closes its done channel before it cancels its
# children (go1.25.0 `internal/fuzz/fuzz.go:129`, `context/context.go:565`
# then `:569`). That cause is PROBABLE, NOT REPRODUCED
# (06_docs/02_features/radar-loops/02-analysis/gate-fuzz-deadline.md). A count
# budget stops through the execution limit and creates no deadline.
#
# A COUNT HAS NO WALL CLOCK, so each fuzz leg also runs under FUZZ_LIMIT
# seconds of real time (D-31) and fails as TIME LIMIT when that runs out. `go
# test -timeout` cannot do this job: the test binary stops its alarm before it
# starts fuzzing, and `go test` sets no kill timeout while fuzzing (go1.25.0
# `testing/testing.go:2335-2340`, `cmd/go/internal/test/test.go:807`).
#
# THE COUNT IS PER TARGET (D-10), because the targets differ by more than a
# hundred times in runs per second. Each count below was set on 2026-09-22 on
# this machine (an 18-core Apple M-series Mac) from the leg's own measured
# duration, so every target does about sixty seconds of work.
#
# TO RECALIBRATE, one target: run the gate, read that leg's printed duration,
# and scale its count by sixty over that duration. A short `-fuzztime 8s` run
# is NOT enough to derive a count from: a leg also re-gathers baseline coverage
# over the whole cached corpus before it fuzzes, and that overhead does not
# shrink, so counts derived that way are badly wrong. The printed duration is the calibration
# instrument; a leg that no longer takes about a minute is the drift signal,
# and it is why the durations are printed at all.
#
# A TARGET WITH NO ROW IS NAMED AND RUN AT THE DEFAULT, never skipped and never
# silently under-fuzzed.
fuzz_execs() {
  case "$1" in
    FuzzEveryReturnedStringIsClean) echo "300000x" ;;
    FuzzPaint)                      echo "520000x" ;;
    FuzzTable)                      echo "16500000x" ;;
    FuzzDecode)                     echo "3790000x" ;;
    FuzzAgree)                      echo "5700000x" ;;
    FuzzClean)                      echo "4320000x" ;;
    FuzzCommandLine)                echo "7060000x" ;;
    FuzzImage)                      echo "12190000x" ;;
    FuzzArea)                       echo "8320000x" ;;
    FuzzHandIn)                     echo "9380000x" ;;
    FuzzDirectory)                  echo "8740000x" ;;
    FuzzOpenAndFind)                echo "9090000x" ;;
    FuzzHeader)                     echo "9320000x" ;;
    FuzzTileJSON)                   echo "11210000x" ;;
    FuzzStyle)                      echo "11490000x" ;;
    FuzzKey)                        echo "23620000x" ;;
    *)                              echo "" ;;
  esac
}
FUZZ_EXECS_DEFAULT="5000000x"
FUZZ_LIMIT="${GATE_FUZZ_LIMIT:-600}"
case "$FUZZ_LIMIT" in
  ''|*[!0-9]*|0) echo "gate: GATE_FUZZ_LIMIT must be a whole number of seconds above zero, not '$FUZZ_LIMIT'" >&2; exit 2 ;;
esac
TARGETS="darwin/arm64 darwin/amd64 linux/amd64 linux/arm64 windows/amd64"

quick=0
docs=0
fuzzonly=0
mode="full"
modes=0
for arg in "$@"; do
  case "$arg" in
    --quick) quick=1; mode="quick"; modes=$((modes + 1)) ;;
    --docs) docs=1; quick=1; mode="docs"; modes=$((modes + 1)) ;;
    --fuzz) fuzzonly=1; mode="fuzz"; modes=$((modes + 1)) ;;
    *) echo "gate: unknown argument: $arg" >&2; exit 2 ;;
  esac
done
# TWO MODES TOGETHER SKIPPED EVERY LEG AND PRINTED GREEN (D-40): each mode
# turns legs off, and nothing was left on. One mode a run.
if [ "$modes" -gt 1 ]; then
  echo "gate: give one mode at most (--quick, --docs or --fuzz), not $modes" >&2
  exit 2
fi

root="${GATE_ROOT:-}"
if [ -z "$root" ]; then
  root="$(cd "$(dirname "$0")/.." && pwd)"
fi
cd "$root" || { echo "gate: cannot enter $root" >&2; exit 2; }

# --- every run leaves a line -------------------------------------------------
started_at=$SECONDS
made_work=0
# THE LINE NAMES THE TREE THAT WAS TESTED (D-40), not only the commit below
# it: the git tree of what was checked, leaving this log out - the staged
# change for the docs lane, the whole working tree otherwise. A commit made
# from exactly that is the same tree less this file, so a reader can match the
# two. Every override of the gate's own settings is written beside it.
tested_tree() {
  local index tree
  index="$(mktemp -d)/index" || return 1
  if [ "$docs" = 1 ]; then
    cp "$(git -C "$root" rev-parse --git-path index)" "$index" 2>/dev/null || return 1
  else
    GIT_INDEX_FILE="$index" git -C "$root" read-tree HEAD 2>/dev/null || return 1
    GIT_INDEX_FILE="$index" git -C "$root" add -A 2>/dev/null || return 1
  fi
  GIT_INDEX_FILE="$index" git -C "$root" rm -q --cached --ignore-unmatch 06_docs/gate-runs.md >/dev/null 2>&1
  tree="$(GIT_INDEX_FILE="$index" git -C "$root" write-tree 2>/dev/null)" || return 1
  rm -rf "$(dirname "$index")"
  printf '%s' "${tree:0:12}"
}
log_run() {
  local rc="$1" result="FAILED" head tree overrides=""
  [ -f "$root/06_docs/gate-runs.md" ] || return 0
  [ "$rc" = 0 ] && result="green"
  head="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo none)"
  tree="$(tested_tree || echo unknown)"
  [ -n "${GATE_FUZZ_LIMIT:-}" ] && overrides="GATE_FUZZ_LIMIT=$GATE_FUZZ_LIMIT"
  [ -n "${GATE_ROOT:-}" ] && overrides="${overrides:+$overrides }GATE_ROOT set"
  printf '| %s | %s | %s | %s | %s | %s | %s |\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$head" "$tree" "$mode" "$result" "$((SECONDS - started_at))" "${overrides:--}" >> "$root/06_docs/gate-runs.md"
}
fuzz_legs="$(mktemp)" || exit 2
cleanup() { [ "$made_work" = 1 ] && rm -f "$root/go.work" "$root/go.work.sum"; rm -f "$fuzz_legs"; return 0; }
trap 'rc=$?; cleanup; log_run "$rc"; exit "$rc"' EXIT

# --- the docs lane decides from the change, not from a promise ---------------
# THE LANE IS A RULE THE SCRIPT HOLDS, NOT ONE ANYONE HAS TO REMEMBER. The
# change it judges is what is STAGED - exactly what `git commit` records
# (D-41). Stage, run the lane, commit. Files that are not staged are not part
# of the commit and are left out, and the lane says how many.
if [ "$docs" = 1 ]; then
  if ! git rev-parse --verify -q HEAD >/dev/null 2>&1; then
    echo "gate: the docs lane needs a commit to compare with; run scripts/gate" >&2
    exit 2
  fi
  # EACH GIT COMMAND IS CHECKED ON ITS OWN: a failed diff would otherwise leave
  # only the untracked files to judge, and the lane would pass on half a change.
  if ! staged="$(git diff --cached --name-only --no-renames HEAD)"; then
    echo "gate: the docs lane could not read the staged change (git diff failed); run scripts/gate" >&2
    exit 2
  fi
  if ! loose="$(git status --porcelain --untracked-files=all)"; then
    echo "gate: the docs lane could not read what is not staged (git status failed); run scripts/gate" >&2
    exit 2
  fi
  changed="$(printf '%s\n' "$staged" | grep -v '^$' | grep -vx '06_docs/gate-runs.md' | sort -u || true)"
  unstaged="$(printf '%s\n' "$loose" | grep -v '^$' | grep -v '^[MADRC] ' | grep -vc ' 06_docs/gate-runs.md$' || true)"
  others="$(printf '%s\n' "$changed" | grep -v '\.md$' | grep -v '^$' || true)"
  if [ -n "$others" ]; then
    echo "gate: the docs lane is for a change of Markdown and nothing else. Not Markdown:"
    printf '%s\n' "$others" | sed 's/^/          /'
    echo "What to do: run scripts/gate, every leg (v0.2.0 D-15)."
    exit 1
  fi
  if [ -z "$changed" ]; then
    echo "gate: docs lane - nothing to check: nothing is staged. Stage the change, run the lane, then commit."
    exit 1
  fi
  echo "gate: docs lane - $(printf '%s\n' "$changed" | wc -l | tr -d ' ') Markdown file(s) staged; every module's tests run, and no other leg (v0.2.0 D-15, D-41)"
  if [ "$unstaged" -gt 0 ]; then
    echo "gate: docs lane - $unstaged file(s) not staged were left out of the judgement; the tests still run on the working tree"
  fi
fi

export GOTOOLCHAIN="$FLOOR_TOOLCHAIN"
export GOFLAGS="-mod=readonly"

failures=""
fail() { failures="${failures}  FAILED  $1"$'\n'; echo "  FAILED  $1"; }
pass() { echo "  ok      $1"; }

# limited SECONDS COMMAND... runs a command in a process group of its own and,
# when SECONDS of wall-clock time run out, stops the whole group - TERM, then
# KILL five seconds later for anything that ignored TERM - and says so. It
# exists for the fuzz legs, whose run-count budget has no clock of its own
# (D-31). perl starts the group because macOS has no setsid; `exec {$ARGV[0]}`
# never hands a lone argument to a shell.
#
# THE WATCHDOG REPORTS THROUGH ITS EXIT STATUS (124 when it fired), not a
# file (D-40). Once it has fired it ignores the TERM the caller sends at the
# end, so the KILL always happens: a group member that survived TERM would
# otherwise hold the output pipe open and the limit would not be one.
limited() {
  local limit="$1" pid dog rc dogrc
  shift
  perl -e 'setpgrp(0, 0); exec { $ARGV[0] } @ARGV or die "cannot run $ARGV[0]: $!\n"' -- "$@" &
  pid=$!
  (
    fired=0
    nap=""
    trap 'if [ "$fired" = 0 ]; then [ -n "$nap" ] && kill "$nap" 2>/dev/null; exit 0; fi' TERM
    sleep "$limit" &
    nap=$!
    wait "$nap"
    if kill -0 "$pid" 2>/dev/null; then
      fired=1
      kill -TERM -- "-$pid" 2>/dev/null
      sleep 5 &
      nap=$!
      wait "$nap" || wait "$nap"
      kill -KILL -- "-$pid" 2>/dev/null
      exit 124
    fi
    exit 0
  ) &
  dog=$!
  wait "$pid"
  rc=$?
  kill -TERM "$dog" 2>/dev/null
  wait "$dog"
  dogrc=$?
  if [ "$dogrc" = 124 ]; then
    echo "TIME LIMIT: stopped after ${limit}s of wall-clock time - slow or stalled, it did not finish (FUZZ_LIMIT; GATE_FUZZ_LIMIT overrides it)"
    return 124
  fi
  return "$rc"
}

# gofmt_clean fails, naming the files, when gofmt would change any Go file in
# this module outside testdata.
gofmt_clean() {
  local files
  # This module's own files: testdata, and any nested module (a directory with
  # a go.mod of its own), are left to themselves.
  files="$(find . \( -type d \( -name testdata -o -name vendor \) -prune \) -o \( -type d ! -path . -exec test -e '{}/go.mod' \; -prune \) -o \( -name '*.go' -print \))" || return 1
  [ -n "$files" ] || return 0
  local unformatted
  unformatted="$(printf '%s\n' "$files" | xargs gofmt -l)" || return 1
  if [ -n "$unformatted" ]; then
    echo "gofmt would change these files; run gofmt -w on them:"
    printf '%s\n' "$unformatted"
    return 1
  fi
}

# leg NAME COMMAND... runs one leg and records the outcome. The output of a
# failing leg is shown; a passing leg is one line.
# EVERY LEG IS TIMED, and the duration is printed beside it. A fuzz leg is
# budgeted in runs rather than seconds, so its duration is the only place a
# target that has grown slower - or a machine that has - becomes visible.
leg() {
  local name="$1"; shift
  local out started elapsed
  started=$SECONDS
  if out="$("$@" 2>&1)"; then
    elapsed=$((SECONDS - started))
    pass "$name [${elapsed}s]"
  else
    elapsed=$((SECONDS - started))
    fail "$name [${elapsed}s]"
    printf '%s\n' "$out" | sed 's/^/          /'
  fi
}

echo "gate: $root"
echo "gate: toolchain $FLOOR_TOOLCHAIN, read-only modules$([ "$quick" = 1 ] && echo ', quick legs only')"

# --- the workspace file is never tracked -------------------------------------
if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  tracked="$(git -C "$root" ls-files -- go.work go.work.sum)"
  if [ -n "$tracked" ]; then
    fail "go.work is tracked: $(echo $tracked). Remove it from the index (git rm --cached) - the gate writes its own"
  fi
fi

# --- every module, found by its module file ----------------------------------
modules="$(find . -name go.mod -not -path '*/testdata/*' -not -path '*/.*' -not -path './_*' -not -path './dist/*' | sed 's|/go.mod$||' | sort)"
if [ -z "$modules" ]; then
  echo "gate: no module found under $root" >&2
  exit 2
fi

# --- the throw-away workspace file ------------------------------------------
if [ -z "${tracked:-}" ]; then
  rm -f go.work go.work.sum
  if GOFLAGS= go work init $modules >/dev/null 2>&1; then
    made_work=1
    # A workspace alone does not resolve a version that was never published:
    # once the library imports third-party code, a separate module that
    # requires the library at v0.0.0 sends the toolchain looking for that
    # version. A replace for exactly that version, in this throw-away file,
    # points it at the tree. Tracked module files still carry no replace.
    if [ -f go.mod ]; then
      root_module="$(GOWORK=off GOFLAGS= go list -m 2>/dev/null)"
      [ -n "$root_module" ] && GOFLAGS= go work edit -replace="${root_module}@v0.0.0=./" >/dev/null 2>&1
    fi
  else
    fail "could not write the workspace file"
  fi
fi
for dir in $modules; do
  path="$(cd "$dir" && GOWORK=off go list -m 2>/dev/null)"
  echo
  echo "module ${path:-$dir}"
  (
    cd "$dir" || exit 1
    failures=""
    # A module whose packages arrive with a later work package has nothing
    # to check yet. It is named and said to be empty - not failed, not hidden.
    # A MODULE GO CANNOT LIST IS BROKEN, NOT EMPTY (D-31): its failure is
    # read, never mistaken for an absence of packages.
    if ! pkgs="$(go list ./... 2>/dev/null)"; then
      fail "its packages cannot be listed"
      go list ./... 2>&1 | sed 's/^/          /'
      exit 1
    fi
    if [ -z "$pkgs" ]; then
      echo "  empty   no Go packages yet"
      exit 0
    fi
    if [ "$docs" = 1 ]; then
      leg "tests (docs lane)" go test -count=1 ./...
      [ -z "$failures" ]
      exit
    fi
    if [ "$fuzzonly" = 0 ]; then
      # FORMATTING IS CHECKED (D-46): a test file once sat unformatted through
      # several green runs because no leg asked.
      leg "gofmt" gofmt_clean
      leg "vet" go vet ./...
      leg "tests, race detector on" go test -race ./...
      leg "tests, race detector off (allocation counts live here)" go test ./...
      # A licence file for every module in this module's graph. A module of
      # this repository is covered by the repository's own licence file. A
      # GRAPH THAT CANNOT BE LISTED FAILS (D-40): it used to be a loop over
      # nothing, which passed, in every module that requires the library.
      if ! graph="$(go list -m -f '{{.Dir}}' all 2>&1)"; then
        fail "the licence check cannot list this module's graph"
        printf '%s\n' "$graph" | sed 's/^/          /'
      elif [ -z "$graph" ]; then
        fail "the licence check found no module in this module's graph"
      else
        for mdir in $graph; do
          case "$mdir" in "$root"|"$root"/*) mdir="$root" ;; esac
          if ! ls "$mdir"/LICEN[SC]E* >/dev/null 2>&1; then
            fail "no licence file in $mdir"
          fi
        done
      fi
    fi
    if [ "$quick" = 0 ]; then
      for pkg in $pkgs; do
        # TESTS THAT CANNOT BE LISTED ARE A FAILURE, not an absence of fuzz
        # targets (D-40).
        if ! listing="$(go test -list '^Fuzz' "$pkg" 2>&1)"; then
          fail "the tests of $pkg cannot be listed, so its fuzz targets cannot be found"
          printf '%s\n' "$listing" | sed 's/^/          /'
          continue
        fi
        for target in $(printf '%s\n' "$listing" | grep '^Fuzz'); do
          echo "$target" >> "$fuzz_legs"
          execs="$(fuzz_execs "$target")"
          if [ -z "$execs" ]; then
            execs="$FUZZ_EXECS_DEFAULT"
            echo "  note    fuzz $target has no calibrated count; running the default $execs"
          fi
          leg "fuzz $target, $execs" limited "$FUZZ_LIMIT" go test -run '^$' -fuzz "^${target}\$" -fuzztime "$execs" "$pkg"
        done
      done
    fi
    if [ "$quick" = 0 ] && [ "$fuzzonly" = 0 ]; then
      if command -v govulncheck >/dev/null 2>&1; then
        # The floor toolchain keeps a newer API out; it is not what a release
        # is built with, and its standard library carries every vulnerability
        # fixed since. The scan runs on this machine's own toolchain, named here.
        leg "vulnerability scan, module and standard library at $(GOTOOLCHAIN=local go env GOVERSION)" env GOTOOLCHAIN=local govulncheck ./...
      else
        fail "govulncheck is not installed: go install golang.org/x/vuln/cmd/govulncheck@latest"
      fi
    fi
    [ -z "$failures" ]
  ) || failures="${failures}  FAILED  module ${path:-$dir}"$'\n'
done

# A FUZZ RUN THAT RAN NO FUZZ LEG CHECKED NOTHING (D-40).
if [ "$fuzzonly" = 1 ] && [ ! -s "$fuzz_legs" ]; then
  fail "no fuzz leg ran: no module has a fuzz target that could be listed"
fi

# --- the library only ---------------------------------------------------------
if [ "$quick" = 0 ] && [ "$fuzzonly" = 0 ]; then
  echo
  echo "library"
  for target in $TARGETS; do
    leg "cross-compile $target, C toolchain off" env CGO_ENABLED=0 GOOS="${target%/*}" GOARCH="${target#*/}" go build ./...
  done
  # Reference frames must be byte-identical on a second architecture. This
  # leg FAILS - never skips - when the second architecture cannot be run.
  host_arch="$(go env GOARCH)"
  other_arch="amd64"; [ "$host_arch" = "amd64" ] && other_arch="arm64"
  leg "tests on $other_arch (emulated here; real hardware is NOT RUN)" env GOARCH="$other_arch" go test ./...
fi

echo
if [ -n "$failures" ]; then
  echo "gate: FAILED"
  printf '%s' "$failures"
  echo "What to do: fix each FAILED leg above and run the gate again. Nothing merges until it is green."
  exit 1
fi
if [ "$docs" = 1 ]; then
  echo "gate: green (docs lane)"
  echo "NOT RUN, by the docs lane's design: every leg but the tests. A change with any file that is not Markdown needs scripts/gate."
  exit 0
fi
echo "gate: green"
# THE LAST RELEASE TAG IS NEVER IN A WORK BRANCH'S HISTORY: releases are
# squash-merged (D-1), so `git describe` finds nothing; the tags are listed
# instead (D-40).
last_tag="$(git -C "$root" tag --list 'v*' --sort=-v:refname 2>/dev/null | head -1)"
case "$mode" in
  quick) echo "NOT RUN in this mode (--quick): fuzzing, the vulnerability scan, the cross-compiles and the second architecture." ;;
  fuzz) echo "NOT RUN in this mode (--fuzz): vet, the tests, licences, the vulnerability scan, the cross-compiles and the second architecture." ;;
esac
echo "NOT RUN on this machine, and not assumed: Linux and Windows test runs; real amd64 hardware; the nightly one-hour soak; the contract check against the last tag (${last_tag:-none exists yet}${last_tag:+: not built yet, v0.2.0 L-4})."
